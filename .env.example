# Copy this file to .env and adjust values for your local secscan instance.
# Docker Compose automatically reads .env from the repository root.

# Unique Compose project name. Use a different value for each simultaneously
# running secscan instance so containers, networks, reports, and cache volumes
# remain isolated.
SECSCAN_COMPOSE_PROJECT=secscan-local

# Image used by the service and CLI. Keep secscan:local for normal local
# builds. To run a release, copy its exact name@sha256:digest reference from
# the GitHub Release CONTAINER_IMAGE asset and use Compose with --no-build.
SECSCAN_IMAGE=secscan:local

# Host address and port for the secscan web GUI and REST API. Keep loopback
# unless trusted LAN access is intentionally enabled. For LAN access, prefer
# the host's exact private IP and configure SECSCAN_API_TOKEN plus a host
# firewall rule limited to the trusted subnet.
SECSCAN_BIND_ADDRESS=127.0.0.1
SECSCAN_PORT=8000

# Local directory mounted read-only inside the container at /workspace.
# Use an absolute path when scanning a project outside this repository.
SECSCAN_WORKSPACE=.

# Maximum concurrent scan jobs handled by the local service.
SECSCAN_WORKERS=2

# Browser account settings. The first successfully registered account becomes
# the bootstrap administrator. Set registration to false after creating the
# intended local accounts when open self-registration is not desired.
SECSCAN_REGISTRATION_ENABLED=true
# Set true only when secscan is actually served over HTTPS; Secure cookies do
# not work over the default local HTTP Compose endpoint.
SECSCAN_SESSION_COOKIE_SECURE=false

# Optional bearer token protecting /api/v1 endpoints for automation clients.
# Browser sessions and this bearer-token compatibility path are independent.
SECSCAN_API_TOKEN=

# Optional server-side GitHub token used only when cloning github.com repositories.
# This value is not submitted by the browser and is not stored in scan history.
# Prefer a fine-grained token with read-only Contents access to only the repositories
# that secscan needs to inspect. Leave blank for public repositories only.
SECSCAN_GITHUB_TOKEN=

# Optional absolute in-container path to a local CISA Known Exploited
# Vulnerabilities JSON catalog. With Compose, place the file beneath
# SECSCAN_WORKSPACE and use a path such as /workspace/kev.json. Secscan never
# downloads or refreshes the catalog. Leave blank to disable KEV enrichment.
SECSCAN_KEV_CATALOG=

# Optional absolute in-container path to a local FIRST EPSS daily CSV. With
# Compose, place the uncompressed CSV beneath SECSCAN_WORKSPACE and use a path
# such as /workspace/epss.csv. Scores are informational prioritization signals;
# secscan does not impose an EPSS pass/fail threshold. Leave blank to disable.
SECSCAN_EPSS_CSV=

# Optional encryption master key enabling GUI-managed SSH credential profiles.
# Generate one with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep the same value for as long as you need to decrypt stored profiles. Losing
# or rotating it without re-creating profiles makes the encrypted private keys
# unreadable. Never commit a populated .env file.
SECSCAN_CREDENTIAL_KEY=

# SSH settings used by authenticated Linux-host scans and CLI Windows-host
# scans. GUI-managed encrypted credential profiles are preferred for Linux when
# SECSCAN_CREDENTIAL_KEY is configured. Windows GUI submission is not part of
# Sprint 51; the windows-host scanner uses these file-based settings through the
# CLI. Both scanners require public-key authentication and strict known-host
# verification; passwords and TOFU/accept-new are not supported.
SECSCAN_SSH_DIR=./.secscan-ssh
SECSCAN_SSH_USER=
SECSCAN_SSH_KEY=/run/secscan-ssh/id_ed25519
SECSCAN_SSH_KNOWN_HOSTS=/run/secscan-ssh/known_hosts
SECSCAN_SSH_PORT=22
